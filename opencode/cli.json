{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "leader": "ctrl+o",
    "session.line.up": "ctrl+alt+y,super+k",
    "session.line.down": "ctrl+alt+e,super+j",
    "session.half.page.up": "ctrl+alt+u,ctrl+k",
    "session.half.page.down": "ctrl+alt+d,ctrl+j",
    "input.move.up": "up",
    "input.move.down": "down",
    "prompt.history.previous": "alt+up",
    "prompt.history.next": "alt+down",
    "composer.subagent.up": "up",
    "composer.subagent.down": "down",
    "composer.shell.up": "up",
    "composer.shell.down": "down",
    "composer.terminal.up": "up,k",
    "composer.terminal.down": "down,j",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.delete.to.line.end": "none"
  },
  "diffs": {
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "verbosity": "high"
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "mode": "off"
  }
}
