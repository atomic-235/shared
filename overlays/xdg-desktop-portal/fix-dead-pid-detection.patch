--- a/src/xdp-app-info-flatpak.c
+++ b/src/xdp-app-info-flatpak.c
@@ -669,9 +669,18 @@
             }
         }
 
-      /* Otherwise, we should be able to open the root dir. Probably the app died and
-         we're failing due to /proc/$pid not existing. In that case fail instead
-         of treating this as privileged. */
+      /* If the process exited (ENOENT/ESRCH), it's definitely not a Flatpak.
+       * Treat as WRONG_APP_KIND so the caller falls through to host app detection
+       * instead of aborting the entire request. */
+      if (errno == ENOENT || errno == ESRCH)
+        {
+          g_set_error (error, XDP_APP_INFO_ERROR, XDP_APP_INFO_ERROR_WRONG_APP_KIND,
+                       "Not a flatpak (process exited)");
+          return -1;
+        }
+
+      /* Otherwise, something unexpected went wrong. Fail to avoid treating
+       * an unknown process as privileged. */
       g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
                    "Unable to open %s", root_path);
       return -1;
